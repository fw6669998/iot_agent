# llm
LLM_MODEL=qwen3.8-max
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-xxx

# AccessKey 建议使用 RAM 子账号并仅授予 AliyunIOTFullAccess 权限
ALI_IOT_ACCESS_KEY_ID=xxx
ALI_IOT_ACCESS_KEY_SECRET=xxx
ALI_IOT_REGION_ID=cn-shanghai
# 企业版实例ID; 旧版公共实例留空
ALI_IOT_INSTANCE_ID=
# 可选, 留空则用 iot.${REGION_ID}.aliyuncs.com
ALI_IOT_ENDPOINT=
# MQTT 安全模式: 3=TCP直连(1883, 默认), 2=TLS直连(8883)
ALI_IOT_SECURE_MODE=3

DEPLOY_HOST=127.0.0.1